{
  "expo": {
    "name": "zelo",
    "slug": "zelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/zelo-icon.png",
    "scheme": "zelo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/zelo-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/zelo-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.zelo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/zelo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/zelo-splash.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
